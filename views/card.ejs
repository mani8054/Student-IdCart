<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Student Records</title>

    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">

</head>
<body class="bg-light">

    <%- include("common/menu") %>

    <div class="container mt-5">
        <h2 class="text-center text-primary mb-4">Student Record System</h2>

        <table class="table table-bordered table-striped table-hover text-center shadow">
            <thead class="table-dark">
                <tr>
                    <th>Student ID</th>
                    <th>Student Name</th>
                    <th>PHOTO</th>
                    <th>Manage</th>
                    <th>Record</th>
                </tr>
            </thead>

            <tbody>
                <% students.forEach(student => { %>
                    <tr>
                        <td>
                            <img src="<%= student.photo %>" width="70" height="70" style="object-fit:cover;">
                        </td>
                        <td><%= student.id %></td>
                        <td><%= student.name %></td>
                </tr>
                <% }) %>
            </tbody>
        </table>
    </div>

</body>
</html>
