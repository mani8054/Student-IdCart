<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Add Student</title>

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
<link rel="stylesheet" href="/style/layout.css">
<style>
body{
    margin:0;
    font-family: system-ui;
}

/* MAIN LAYOUT */
.wrapper{
    display:flex;
    min-height:100vh;
}

/* LEFT */
.left{
    flex:1;
    background: url('https://images.unsplash.com/photo-1523240795612-9a054b0db644') center/cover no-repeat;
    position:relative;
}

.left::before{
    content:"";
    position:absolute;
    inset:0;
    background: rgba(0,0,0,0.55);
}

.left-content{
    position:relative;
    z-index:1;
    color:white;
    padding:40px;
}

.left-content h1{
    font-size:22px;
    font-weight:600;
}

.left-content p{
    font-size:13px;
    opacity:0.8;
}

/* RIGHT */
.right{
    flex:1;
    display:flex;
    align-items:center;
    justify-content:center;
    background:#f7f7f7;
}

/* FORM BOX (SMALLER) */
.form-box{
    width:280px;   /* smaller width */
}

/* TITLE */
h5{
    font-size:15px;
    margin-bottom:10px;
}

/* LABEL */
label{
    font-size:11px;
    color:#555;
    margin-bottom:3px;
}

/* INPUT */
.form-control{
    font-size:12px;
    border-radius:5px;
    padding:6px 8px;
}

/* BUTTON */
.btn-submit{
    width:100%;
    padding:7px;
    background:#111;
    color:#fff;
    border:none;
    border-radius:5px;
    font-size:12px;
}

.btn-submit:hover{
    background:#000;
}

/* spacing reduction */
.mb-2{
    margin-bottom:8px !important;
}
.mb-3{
    margin-bottom:10px !important;
}
</style>
</head>

<body>

<%- include("common/menu") %>
<br>
<div class="wrapper">

    <!-- LEFT -->
    <div class="left">
        <div class="left-content">
            <h1>Student System</h1>
            <p>Manage students and ID cards in a simple modern way.</p>
        </div>
    </div>

    <!-- RIGHT -->
    <div class="right">

        <div class="form-box">

            <h5>Add Student</h5>

            <form action="/fooo" method="POST" enctype="multipart/form-data">

                <div class="mb-2">
                    <label>ID</label>
                    <input type="number" name="id" class="form-control" required>
                </div>

                <div class="mb-2">
                    <label>Name</label>
                    <input type="text" name="name" class="form-control" required>
                </div>

                <div class="mb-2">
                    <label>Class</label>
                    <input type="text" name="classs" class="form-control" required>
                </div>

                <div class="mb-2">
                    <label>Email</label>
                    <input type="email" name="email" class="form-control" required>
                </div>

                <div class="mb-3">
                    <label>Photo</label>
                    <input type="file" name="photo" class="form-control">
                </div>

                <button class="btn-submit">Save</button>

            </form>

        </div>

    </div>

</div>

</body>
</html>