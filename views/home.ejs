<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Home</title>

    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/style/layout.css">
</head>
<body class="bg-light">

    <%- include("common/menu") %>

    <div class="container mt-5">

        <!-- Page Title -->
        <div class="text-center mb-4">
            <h2 class="fw-bold text-primary">Student ID Card System</h2>
            <p class="text-muted">Manage student records easily</p>
        </div>

        <!-- Profile Card -->
        <div class="card shadow-lg border-0 rounded-4 mx-auto" style="max-width: 600px;">
            <div class="card-body text-center p-4">

                <!-- Profile Image -->
                <img src="https://via.placeholder.com/100"
                     class="rounded-circle mb-3"
                     alt="profile">

                <h4 class="fw-semibold">Welcome, Admin 👋</h4>
                <p class="text-muted">Manage student data and generate ID cards</p>

                <!-- Buttons -->
                <div class="d-grid gap-2 mt-3">
                    <a href="/add-student" class="btn btn-primary">
                        ➕ Add New Student
                    </a>
                    <a href="/view-students" class="btn btn-outline-secondary">
                        📋 View Students
                    </a>
                </div>

            </div>
        </div>

    </div>

</body>
</html>