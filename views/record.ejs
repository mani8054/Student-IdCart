<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Student Records</title>

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
<link rel="stylesheet" href="/style/layout.css">
<style>
body{
    font-family: system-ui;
    margin:0;

    /* Background Image */
    background: url('https://images.unsplash.com/photo-1523240795612-9a054b0db644') center/cover no-repeat;
    min-height:100vh;
}


body::before{
    content:"";
    position:fixed;
    inset:0;
    background: rgba(0,0,0,0.55);
    z-index:-1;
}

.title{
    color:white;
    text-shadow:0 2px 10px rgba(0,0,0,0.5);
}


.table-box{
    max-width:1100px;
    margin:auto;
    background:#fff;
    border-radius:10px;
    overflow:hidden;
    box-shadow:0 8px 25px rgba(0,0,0,0.08);
}

/* table style */
table{
    margin:0;
    font-size:14px;
}

thead{
    background:#111;
    color:#fff;
}

tbody tr:hover{
    background:#f1f3f5;
}

/* image */
img{
    width:50px;
    height:50px;
    object-fit:cover;
    border-radius:50%;
}

/* buttons */
.btn-sm{
    font-size:12px;
    padding:5px 10px;
    border-radius:6px;
}

/* add button floating */
.add-btn{
    position:fixed;
    right:25px;
    bottom:25px;
    background:#111;
    color:#fff;
    padding:10px 14px;
    border-radius:50px;
    text-decoration:none;
    font-size:13px;
    box-shadow:0 5px 15px rgba(0,0,0,0.2);
}

.add-btn:hover{
    background:#000;
}
</style>

</head>

<body>

<div class="title">
    📚 Student Record System
</div>

<div class="table-box">

    <div class="table-responsive">
        <table class="table table-hover align-middle text-center mb-0">

            <thead>
                <tr>
                    <th>ID</th>
                    <th>Name</th>
                    <th>Class</th>
                    <th>Email</th>
                    <th>Photo</th>
                    <th>Manage</th>
                    <th>Record</th>
                </tr>
            </thead>

            <tbody>
                <% students.forEach(student => { %>
                <tr>

                    <td class="fw-semibold"><%= student.id %></td>
                    <td class="text-capitalize"><%= student.name %></td>
                    <td><%= student.classs %></td>
                    <td><%= student.email %></td>

                    <td>
                        <img src="<%= student.photo %>">
                    </td>

                    <td>
                        <a href="/edit/<%= student.id %>" class="btn btn-warning btn-sm">Edit</a>
                        <a href="/delete/<%= student.id %>" class="btn btn-danger btn-sm"
                           onclick="return confirm('Delete this record?');">
                           Delete
                        </a>
                    </td>

                    <td>
                        <a href="/download/<%= student.id %>" class="btn btn-success btn-sm">
                            ID Card
                        </a>
                    </td>

                </tr>
                <% }) %>
            </tbody>

        </table>
    </div>

</div>

<!-- Floating Add Button -->
<a href="/student" class="add-btn">+ Add Student</a>

</body>
</html>