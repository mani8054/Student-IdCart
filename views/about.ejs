<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>About</title>

    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/style/layout.css">
</head>
<body class="bg-light">

    <%- include("common/menu") %>

    <div class="container mt-5">

        <!-- Page Title -->
        <div class="text-center mb-4">
            <h2 class="fw-bold text-primary">About Project</h2>
            <p class="text-muted">Student ID Card Management System</p>
        </div>

        <!-- About Card -->
        <div class="card shadow-lg border-0 rounded-4 mb-4">
            <div class="card-body p-4">
                <h4 class="fw-semibold mb-3">📌 Project Description</h4>
                <p class="text-muted">
                    This project is designed to manage student information and generate student ID cards easily.
                    It allows users to add student details, upload photos, and organize records efficiently.
                </p>
            </div>
        </div>

        <!-- Features -->
        <div class="card shadow border-0 rounded-4 mb-4">
            <div class="card-body p-4">
                <h4 class="fw-semibold mb-3">🚀 Features</h4>
                <ul class="list-group list-group-flush">
                    <li class="list-group-item">✔ Add new student details</li>
                    <li class="list-group-item">✔ Upload student photo</li>
                    <li class="list-group-item">✔ Generate ID cards</li>
                    <li class="list-group-item">✔ View and manage students</li>
                </ul>
            </div>
        </div>

        <!-- Developer Card -->
        <div class="card shadow border-0 rounded-4 text-center" style="max-width: 400px; margin:auto;">
            <div class="card-body p-4">
                <img src="https://via.placeholder.com/100" class="rounded-circle mb-3" alt="developer">
                <h5 class="fw-semibold">Your Name</h5>
                <p class="text-muted">Full Stack Developer</p>
                <p class="small text-muted">
                    Passionate about building web applications using Node.js, Express, and Bootstrap.
                </p>
            </div>
        </div>

    </div>

</body>
</html>